# Copy to .env and edit. Every setting is in seekr/config.py; these are the ones you usually change.
SEEKR_DB=data/seekr.db            # SQLite database (put it on a big disk)
SEEKR_DEVICE=                     # empty = auto (cuda > xpu > mps > cpu)
SEEKR_HOST=127.0.0.1              # 0.0.0.0 to serve on the network
SEEKR_PORT=8000
SEEKR_CONTACT=                    # "Name; email" added to the crawler User-Agent (Wikipedia requires it)
SEEKR_MAX_PAGES_PER_DOMAIN=300
SEEKR_LOG_LEVEL=INFO
