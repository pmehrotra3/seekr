# Crawl nonstop on four low-power cores, as a user service:
#   sed "s#/path/to/seekr#$PWD#g" deploy/seekr-crawler.service > ~/.config/systemd/user/seekr-crawler.service
#   systemctl --user daemon-reload && systemctl --user enable --now seekr-crawler
# Logs: journalctl --user -u seekr-crawler -f
[Unit]
Description=Seekr crawler (nonstop)
After=network-online.target

[Service]
WorkingDirectory=/path/to/seekr
EnvironmentFile=-/path/to/seekr/.env
Environment=SEEKR_MAX_PAGES_PER_DOMAIN=20000 SEEKR_MAX_DEPTH=5
ExecStart=/path/to/seekr/.venv/bin/seekr crawl --forever
# Core Ultra 9 285H: CPUs 12-13 are efficiency cores, 14-15 low-power efficiency cores. Change for other CPUs.
CPUAffinity=12-15
Nice=10
IOSchedulingClass=idle
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
